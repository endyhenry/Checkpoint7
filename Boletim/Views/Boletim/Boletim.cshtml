@{
    ViewData["Title"] = "Meu Boletim";
    var disciplinas = ViewBag.disciplina as List<string> ?? new List<string>();
    var notas = ViewBag.nota as List<double> ?? new List<double>();
    var media = notas.Count > 0 ? notas.Average() : 0.0;
}

<div class="text-center">
    <h1 class="display-4">Bem Vindos</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Disciplina</th>
                <th>Nota</th>
                <th>Status</th>
                <th>Conceito</th>
            </tr>
        </thead>
        <tbody>
@for (int i = 0; i < disciplinas.Count && i < notas.Count; i++)
{
    var nota = notas[i];
    var aprovado = nota >= 6;
    var rowClass = aprovado ? "table-success" : "table-danger";
    var status = aprovado ? "Aprovado" : "Reprovado";
    var conceito = nota switch
    {
        >= 9 => "A",
        >= 7 => "B",
        >= 5 => "C",
        _ => "D"
    };

    <tr class="@rowClass">
        <td>@disciplinas[i]</td>
        <td>@($"{nota:F1}")</td>
        <td>@status</td>
        <td>@conceito</td>
    </tr>
}
        </tbody>
        <tfoot>
            <tr>
                <th>Média geral</th>
                <th>@($"{media:F2}")</th>
                <th colspan="2"></th>
            </tr>
        </tfoot>
    </table>
</div>